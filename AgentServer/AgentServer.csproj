<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ApprovalRequiredAIFunction, the OpenAI agent surface and the session stores are marked experimental. -->
    <NoWarn>$(NoWarn);MEAI001;OPENAI001;MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions Microsoft's AgenticUI sample pins (updated 27 Oct 2026). -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.26.0-preview.261023.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageReference Include="AGUI.Server" Version="1.0.1" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

</Project>
