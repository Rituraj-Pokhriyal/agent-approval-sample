<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions Microsoft's AgenticUI sample pins (updated 27 Oct 2026). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.AI" Version="0.1.0-preview.1.26466.103" />
    <!-- Microsoft's sample uses this to keep the shared framework instead of the AI package's newer
         transitive Components.Web. If restore fails on your SDK, see README "If restore fails". -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.3.26522.148" ExcludeAssets="all" NoWarn="NU1510;NU1605" />
    <PackageReference Include="AGUI.Client" Version="1.0.1" />
  </ItemGroup>

</Project>
